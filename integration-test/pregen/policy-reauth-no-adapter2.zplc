# -*- mode: toml -*-
# Leg-3 variant of policy-reauth.zplc (zipline#124): IDENTICAL except that
# adapter2's bootstrap key is removed from [bootstrap]. Installing this
# policy obliges every connected actor to re-authenticate (zipline#123);
# adapter2, whose only credential was that key, cannot, and must be revoked
# by the reauth deadline. The ZPL (and so every rule) is unchanged —
# revocation must come from the failed re-auth, not from a rule change.

[resolver]
order = ["hosts", "dns"]

[resolver.hosts]
"n0.zpr" = "fd5a:5052::2"
"n0.overlay" = "10.0.0.1"

[nodes."node"]
provider = [ [ "device.zpr.adapter.cn", "node" ] ]
zpr_address = "n0.zpr"

[nodes."node".substrate_addrs]
in1 = "n0.overlay:12345"

[trusted_services.default]
cert_path = "ca-cert.pem"

# zipline#107: the `addresses` file store grants each adapter its static ZPR
# address (data: pregen/addresses.json, copied in by
# lib/common_funcs.sh::copy_address_store). adapter2 is granted on its
# authenticated device CN; adapter1 is user-only, so its grant is keyed on
# user.oidc-subject:'user-a'.
[trusted_services.addresses]
api = "file"
returns_attributes = ["zpr_addr -> device.zpr_addr"]
expiration_seconds = 3600

[trusted_services.fake-idp]
api             = "oidc"
issuer          = "https://127.0.0.1:9000"
jwks_uri        = "https://127.0.0.1:9000/jwks"
client_id       = "zpr-test-client"
scopes          = ["openid", "email", "profile"]
allowed_domains = ["example.com"]
seed_jwks       = "oidc-test-seed-jwks.json"

# Long renewal window (see policy-reauth.zplc): no clock-driven renewal
# during the run.
expiration_seconds   = 3600
max_auth_age_seconds = 43200
allow_offline_access = true

returns_attributes = [
  "sub   -> user.oidc-subject",
  "email -> user.email",
  "hd    -> user.domain",
]
identity_attributes = ["sub"]

[visa_service]
dock_node = "node"

# adapter1 is deliberately absent (user-only), and adapter2's key is the
# removal under test.
[bootstrap]
"node" = "node-rsa-pubkey.pem"
"vs.zpr" = "actorvs.pem"

[protocols.ping]
l4protocol = "iana.ICMP6"
icmp_type = "request-response"
icmp_codes = [ 128, 129 ]

[services.A1Svc]
protocol = "ping"
# adapter1's static ZPR address is granted by the `addresses` trusted service
# keyed on user.oidc-subject:'user-a' (its CN is never authenticated). The
# .zpl define supplies the join attribute, so no provider entry here.

[services.A2Svc]
protocol = "ping"
provider = [["device.zpr.adapter.cn", "adapter2"]]

[services.PingableVs]
protocol = "ping"

[services.PingableNode]
protocol = "ping"
