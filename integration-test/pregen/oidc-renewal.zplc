# -*- mode: toml -*-
# Silent-OIDC-renewal integration-test fixture config (zipline#47, plan R7).
#
# Identical to oidc-test.zplc — same topology, same issuer, same fake IdP,
# and it compiles the very same oidc-test.zpl — except for the three
# trusted-service lifetime knobs below. It exists because the renewal e2e
# needs a renewable session on a cadence a test can actually wait out, and
# oidc-test.zplc must keep its long single-clock lifetimes so the
# connect/rotation legs of one-node-oidc-test.sh stay unchanged.
#
# `service` (the JWKS CONNECT proxy) is deliberately omitted — there is no
# proxy in the test and the visa service fetches the JWKS directly — so zplc
# emits a warning; expected, per OIDC.md (omission is not silent, --Werror
# would make it fatal for deployments that care).

[resolver]
order = ["hosts", "dns"]

[resolver.hosts]
"n0.zpr" = "fd5a:5052::2"
"n0.overlay" = "10.0.0.1"

[nodes."node"]
provider = [ [ "device.zpr.adapter.cn", "node" ] ]
zpr_address = "n0.zpr"

[nodes."node".substrate_addrs]
in1 = "n0.overlay:12345"

[trusted_services.default]
cert_path = "ca-cert.pem"

[trusted_services.fake-idp]
api             = "oidc"
issuer          = "https://127.0.0.1:9000"
jwks_uri        = "https://127.0.0.1:9000/jwks"
client_id       = "zpr-test-client"
scopes          = ["openid", "email", "profile"]
allowed_domains = ["example.com"]
# Seed carries only the first fake-idp key; the rotation leg's second key
# must be discovered via a live JWKS refresh (the stale-cache path).
seed_jwks       = "oidc-test-seed-jwks.json"

# The dual clock (zipline#42), sized for a test rather than for a human:
#   renewal window  = token.iat       + expiration_seconds   = 120s, advances
#   session ceiling = token.auth_time + max_auth_age_seconds = 1h,   fixed
# The node renews at `auth_expires - min(AUTH_RENEWAL_LEAD, lifetime/2)`, so
# a 120s window puts the first renewal ~60s in — long enough that the connect
# leg finishes first, short enough to wait out twice. The ceiling is an hour:
# far past the end of the run, so renewals are bounded only by the window and
# the run never trips the reconnect-required path. R1's compiler rule needs
# max_auth_age_seconds >= expiration_seconds, which 3600 >= 120 satisfies.
expiration_seconds   = 120
max_auth_age_seconds = 3600
allow_offline_access = true

returns_attributes = [
  "sub   -> user.oidc-subject",
  "email -> user.email",
  "hd    -> user.domain",
]
identity_attributes = ["sub"]

[visa_service]
dock_node = "node"

# adapter1 is deliberately absent: it authenticates user-only through the
# fake IdP and never presents a bootstrap (device) key.
[bootstrap]
"node" = "node-rsa-pubkey.pem"
"vs.zpr" = "actorvs.pem"
"adapter2" = "actor2.pem"

[protocols.ping]
l4protocol = "iana.ICMP6"
icmp_type = "request-response"
icmp_codes = [ 128, 129 ]

[services.A1Svc]
protocol = "ping"
# zipline#96: pin adapter1's static ZPR address in policy (source 1 of the
# static-address-grants rule). A1Svc is keyed on the user identity, so the
# join policy the pin lands in is user.oidc-subject:'user-a' + zpr.addr.
provider = [["zpr.addr", "fd5a:5052:8888::1:1"]]

[services.A2Svc]
protocol = "ping"
provider = [["zpr.addr", "fd5a:5052:8888::2:1"]]

[services.PingableVs]
protocol = "ping"

[services.PingableNode]
protocol = "ping"
