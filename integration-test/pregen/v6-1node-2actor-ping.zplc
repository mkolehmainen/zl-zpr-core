# -*- mode: toml -*-

[resolver]
order = ["hosts", "dns"]

[resolver.hosts]
"n0.zpr" = "fd5a:5052::2"
"n0.overlay" = "10.0.0.1"

[nodes."node"]
provider = [ [ "device.zpr.adapter.cn", "node" ] ]
zpr_address = "n0.zpr"

[nodes."node".substrate_addrs]
in1 = "n0.overlay:12345"

[trusted_services.default]
cert_path = "ca-cert.pem"

[visa_service]
dock_node = "node"

[bootstrap]
"node" = "node-rsa-pubkey.pem"
"vs.zpr" = "actorvs.pem"
"adapter1" = "actor1.pem"
"adapter2" = "actor2.pem"

[protocols.ping]
l4protocol = "iana.ICMP6"
icmp_type = "request-response"
icmp_codes = [ 128, 129 ]

[services.A1Svc]
protocol = "ping"
# zipline#96: pin the adapter's static ZPR address in policy (source 1 of the
# static-address-grants rule) so the visa service confirms it via the join
# policy rather than committing an unauthenticated claim.
provider = [["zpr.addr", "fd5a:5052:8888::1:1"]]

[services.A2Svc]
protocol = "ping"
provider = [["zpr.addr", "fd5a:5052:8888::2:1"]]

[services.PingableVs]
protocol = "ping"

[services.PingableNode]
protocol = "ping"
