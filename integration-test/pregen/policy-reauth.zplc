# -*- mode: toml -*-
# Policy-install re-authentication fixture config (zipline#124, umbrella #118).
#
# Same topology and fake-IdP pinning as oidc-renewal.zplc, compiling
# policy-reauth.zpl. Differences that matter here:
#
#   - adapter2 is DEVICE-ONLY (bootstrap RSA, no user login), so its
#     install-driven re-auth exercises the SS arm of `reauthorize`
#     (zipline#120/#122). adapter1 stays USER-ONLY (OIDC).
#   - The OIDC lifetimes are LONG (an hour), unlike oidc-renewal.zplc's 120 s:
#     the adapter's clock-driven renewal lead is min(300 s, lifetime/2), so the
#     first clock renewal would be ~55 min in — far past the end of the run.
#     Every re-auth this test observes is therefore driven by a policy install
#     (zipline#123), never by the renewal clock.
#   - The re-auth deadline itself is a VISA SERVICE config setting
#     (`reauth_deadline`, vs-config.toml), not a policy knob; the test sets it
#     to 60 s there.
#
# Two variants compile the same ZPL with one bootstrap key removed each:
# policy-reauth-no-adapter2.zplc (leg 3) and policy-reauth-no-node.zplc
# (leg 4).
#
# `service` (the JWKS CONNECT proxy) is deliberately omitted — no proxy in the
# test — so zplc emits a warning; expected, same as oidc-test.zplc.

[resolver]
order = ["hosts", "dns"]

[resolver.hosts]
"n0.zpr" = "fd5a:5052::2"
"n0.overlay" = "10.0.0.1"

[nodes."node"]
provider = [ [ "device.zpr.adapter.cn", "node" ] ]
zpr_address = "n0.zpr"

[nodes."node".substrate_addrs]
in1 = "n0.overlay:12345"

[trusted_services.default]
cert_path = "ca-cert.pem"

# zipline#107: the `addresses` file store grants each adapter its static ZPR
# address (data: pregen/addresses.json, copied in by
# lib/common_funcs.sh::copy_address_store). adapter2 is granted on its
# authenticated device CN; adapter1 is user-only, so its grant is keyed on
# user.oidc-subject:'user-a'.
[trusted_services.addresses]
api = "file"
returns_attributes = ["zpr_addr -> device.zpr_addr"]
expiration_seconds = 3600

[trusted_services.fake-idp]
api             = "oidc"
issuer          = "https://127.0.0.1:9000"
jwks_uri        = "https://127.0.0.1:9000/jwks"
client_id       = "zpr-test-client"
scopes          = ["openid", "email", "profile"]
allowed_domains = ["example.com"]
seed_jwks       = "oidc-test-seed-jwks.json"

# Long renewal window (see header): no clock-driven renewal during the run.
# allow_offline_access keeps a refresh token in the AuthAgent, so the
# install-driven re-auth is a silent back-channel refresh (leg 2).
expiration_seconds   = 3600
max_auth_age_seconds = 43200
allow_offline_access = true

returns_attributes = [
  "sub   -> user.oidc-subject",
  "email -> user.email",
  "hd    -> user.domain",
]
identity_attributes = ["sub"]

[visa_service]
dock_node = "node"

# adapter1 is deliberately absent: it authenticates user-only through the
# fake IdP and never presents a bootstrap (device) key.
[bootstrap]
"node" = "node-rsa-pubkey.pem"
"vs.zpr" = "actorvs.pem"
"adapter2" = "actor2.pem"

[protocols.ping]
l4protocol = "iana.ICMP6"
icmp_type = "request-response"
icmp_codes = [ 128, 129 ]

[services.A1Svc]
protocol = "ping"
# adapter1's static ZPR address is granted by the `addresses` trusted service
# keyed on user.oidc-subject:'user-a' (its CN is never authenticated). The
# .zpl define supplies the join attribute, so no provider entry here.

[services.A2Svc]
protocol = "ping"
provider = [["device.zpr.adapter.cn", "adapter2"]]

[services.PingableVs]
protocol = "ping"

[services.PingableNode]
protocol = "ping"
