# -*- mode: toml -*-

[resolver]
order = ["hosts", "dns"]

[resolver.hosts]
"n0.zpr" = "fd5a:5052::2"
"n0.overlay" = "10.0.0.1"

[nodes."node"]
provider = [ [ "device.zpr.adapter.cn", "node" ] ]
zpr_address = "n0.zpr"

[nodes."node".substrate_addrs]
in1 = "n0.overlay:12345"

[trusted_services.default]
cert_path = "ca-cert.pem"

# zipline#107: the `addresses` file store grants each statically-addressed
# adapter its ZPR address by vending device.zpr_addr (zipline#99). This v4
# fixture is compile-only (`make rebuild` proof; its 10.253.x addresses fail
# the static-range check, a pre-existing limitation of
# unused_or_outdated/one-node-v4-test.sh), so the store's JSON carries no v4
# entries — the store is runtime VS data and this policy is never run.
[trusted_services.addresses]
api = "file"
returns_attributes = ["zpr_addr -> device.zpr_addr"]
expiration_seconds = 3600

[visa_service]
dock_node = "node"

[bootstrap]
"vs" = "actorvs.pem"
"adapter1" = "actor1.pem"
"adapter2" = "actor2.pem"
"node" = "node-rsa-pubkey.pem"


[protocols.ping]
l4protocol = "iana.ICMP4"
icmp_type = "request-response"
icmp_codes = [ 0, 8 ]

[services.A1Svc]
protocol = "ping"
# zipline#107: the adapter's static ZPR address would be granted by the
# `addresses` trusted service (device.zpr_addr, zipline#99), not pinned in
# policy. The provider entry mirrors the .zpl define's device CN.
provider = [["device.zpr.adapter.cn", "adapter1"]]

[services.A2Svc]
protocol = "ping"
provider = [["device.zpr.adapter.cn", "adapter2"]]

[services.PingableVs]
protocol = "ping"

[services.PingableNode]
protocol = "ping"
